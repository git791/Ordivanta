# ─── Ordivanta — Environment Variables ──────────────────────────────────────
#
# Setup:
#   1. Copy this file to backend/.env  (used by the FastAPI/uvicorn process)
#   2. Copy this file to frontend/.env.local  (used by Next.js dev server)
#   3. Edit each file — keep secrets out of source control.
#
# Windows PowerShell:
#   Copy-Item .env.example backend\.env
#   Copy-Item .env.example frontend\.env.local
#
# macOS/Linux:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local
#
# NEVER commit .env or .env.local.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Backend server ──────────────────────────────────────────────────────────

# Host and port the FastAPI/uvicorn server binds to.
# Change to 0.0.0.0 when running inside Docker or exposing to a network.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000


# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of frontend origins that are allowed to call the API.
# Example for production: https://ordivanta.yourdomain.com
# Keep this as specific as possible — do not use * in production.
ALLOWED_ORIGINS=http://localhost:3000


# ─── Database ────────────────────────────────────────────────────────────────

# SQLite (default — single-user prototype):
DATABASE_URL=sqlite+aiosqlite:///./ordivanta.db

# PostgreSQL (future multi-user deployment — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/ordivanta

# Note: the SQLite file is created automatically by the backend on first startup.
# For PostgreSQL, create the database and run migrations manually.


# ─── MILP Solver ─────────────────────────────────────────────────────────────

# Solver backend used by PuLP.
# Supported values: HiGHS  |  CBC
#
# HiGHS is recommended (open-source, fast, no manual binary needed):
#   pip install highspy
#
# CBC ships with PuLP on most platforms but may need a separate binary:
#   https://github.com/coin-or/Cbc
SOLVER_NAME=HiGHS

# Maximum wall-clock seconds the solver is allowed per solve request.
# Increase for larger instances; decrease to keep the API responsive.
SOLVER_TIME_LIMIT=60


# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
#
# NEXT_PUBLIC_* variables are embedded at Next.js BUILD TIME.
# If you change this value after building, rebuild the frontend.
#
# This must match BACKEND_HOST:BACKEND_PORT above (or a reverse-proxy URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
